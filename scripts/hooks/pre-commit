#!/bin/sh
#
# Pre-commit hook for workout data validation
#
# This hook validates workout plan JSON files before allowing a commit.
# It prevents broken workout data from being committed to the repository.
#
# INSTALLATION:
# Option 1: Copy manually
#   cp scripts/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Option 2: Create symlink
#   ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit

# Check if any workout data files are being committed
# Excludes .schema.json files
WORKOUT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^data/(workout-plan.*|integrated-strength.*)\.json$' | grep -v '\.schema\.json$')

if [ -z "$WORKOUT_FILES" ]; then
  # No workout files being committed, skip validation
  exit 0
fi

echo "🔍 Workout data files detected in commit:"
echo "$WORKOUT_FILES"
echo ""

# Run strict schema validation (extra fields + missing required fields)
node scripts/validate-workout-schema-strict.mjs $WORKOUT_FILES

# Run reference validation ($ref / $routine integrity)
node scripts/validate-workout-data.mjs $WORKOUT_FILES

# Exit with the same code as the validation script
exit $?
