{
  "name": "tracker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "cp data/workout-plan-v2.3.json data/exercises.json colors.css public/",
    "predev": "cp data/workout-plan-v2.3.json data/exercises.json colors.css public/",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "tsc --noEmit",
    "lint:fix": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@automerge/automerge": "^3.2.0",
    "@material/material-color-utilities": "^0.3.0",
    "@sentry/react": "^10.27.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.2",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
