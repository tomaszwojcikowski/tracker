  "plan": {
    "id": "integrated-strength-v26-9",
    "name": "The 20-Week Integrated Strength Program (V26.9: Longevity Update)",
    "description": "Build elite pulling strength (max pull-ups, pull-up variations) while maintaining all-around capacity (pushing, lower body) and protecting knee/shoulder health. Optimized for the 40+ athlete with Volume Management and Joint Longevity principles.",
    "author": "V26.9 Program",
    "createdDate": "2025-12-02",
    "lastModified": "2025-12-02T20:02:00.000Z",
    "version": "26.9.0",
    "durationWeeks": 21,
    "goals": [
      "elite-pulling-strength",
      "max-pull-ups",
      "joint-longevity",
      "volume-management",
      "40-plus-optimization"
    ],
    "targetLevel": "advanced",
    "equipment": [
      "pull-up-bar",
      "rings",
      "dip-bars",
      "resistance-bands",
      "rower",
      "dumbbells",
      "barbell"
    ],
    "programRules": {
      "volumeCap": {
        "weeklyPullUpReps": {
          "min": 36,
          "max": 40
        }
      },
      "earlyWarningSystem": {
        "reduceVolumeBy": 0.3,
        "triggers": [
          "Elbow tightness > 24 hours",
          "Sharp pain during Ring Rows or PPPU",
          "Grip fatigue lasting into Day 3",
          "Shoulder pinch or impingement on Dips or HSPU"
        ]
      },
      "coldStartRowerProtocol": {
        "description": "Before Day 1 & 5 sessions",
        "duration": "5 minutes",
        "protocol": "Min 1-2: Zone 1, Min 3-4: Zone 2, Min 5: 3x10s Sprints"
      },
      "globalTendonPrepWarmup": {
        "description": "Perform immediately after Rower Protocol",
        "exercises": [
          "20 Band Pull-Aparts",
          "15 Band External Rotations per side",
          "3x5 Scapular Pull-ups with 3s ISO-HOLD",
          "20-30s Passive Bar Hang"
        ]
      },
      "repBeforeLoadRule": {
        "description": "Double Progression: Add weight only when hitting top rep range for all sets with perfect form"
      },
      "standardTempo": "2-1-1-0",
      "day5AccessoryCap": "10 minutes hard cap",
      "dipGovernorRule": "If shoulder pinch occurs during weighted dips, switch to Straight Bar Dips or Weighted Bench Dips",
      "gripSaverProtocol": "Day 5 core work must be ground-based (V-Ups/Hollows) to prevent medial epicondylitis"
    },
