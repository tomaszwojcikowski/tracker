                  {
                    "category": "warmup",
                    "exerciseName": "Arm Circles",
                    "sets": 2,
                    "repsType": "time",
                    "repsValue": 30,
                    "notes": "Forward and backward"
                  },
                  {
                    "category": "main",
                    "exerciseName": "Push-Ups",
                    "sets": 3,
                    "repsType": "reps",
                    "repsValue": 8,
                    "notes": "Use knee push-ups if needed"
                  },
                  {
                    "category": "main",
                    "exerciseName": "Inverted Rows",
                    "sets": 3,
                    "repsType": "reps",
                    "repsValue": 8,
                    "notes": "Use a table or bar at hip height"
