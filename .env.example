# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General
# See FIREBASE_SETUP.md for detailed setup instructions

# Required - Your Firebase API key
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Required - Your Firebase project ID
VITE_FIREBASE_PROJECT_ID=your-project-id

# Required - Your Firebase Realtime Database URL
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Optional but recommended - Your Firebase auth domain
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Optional - Your Firebase storage bucket
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Optional - Your Firebase messaging sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Optional - Your Firebase app ID
VITE_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxxx

# Error Reporting Configuration (Sentry)
# Get your DSN from Sentry Dashboard > Settings > Projects > [Your Project] > Client Keys (DSN)
# See ERROR_REPORTING_SETUP.md for detailed setup instructions

# Optional - Your Sentry DSN for error tracking
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXX.ingest.sentry.io/XXXXXXX
