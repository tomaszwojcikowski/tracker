        "repsType": "amrap",
        "repsModifier": -2,
        "loadUnit": "bodyweight",
        "restSeconds": 120,
        "notes": "Stop 2 reps before failure. Technical cap at 30 total reps",
        "alternatives": ["Lat Pulldowns", "Assisted Pull-Ups"]
